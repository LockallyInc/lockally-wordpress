<?xml version="1.0"?>
<ruleset name="Lockally Mail">
	<description>WordPress coding standards, which is what the plugin review runs.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>

	<!-- tests/ is linted like everything else, except for the few rules that
	     only make sense inside WordPress. The tests run on plain PHP from the
	     command line, never as a web request: they print plain text rather than
	     HTML, use global names that nothing else shares, and dump values with
	     var_export() on purpose. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="5.7"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lockally-mail"/>
			</property>
		</properties>
	</rule>
</ruleset>
